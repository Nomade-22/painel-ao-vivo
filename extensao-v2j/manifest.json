{
  "manifest_version": 3,
  "name": "V2J · Sacolinha TikTok",
  "version": "0.6.3",
  "description": "Sincroniza sacolinha e observa estatísticas verificadas da LIVE, além de fotos e descrições. Diagnóstico passivo opcional de chamadas durante a LIVE.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://shop.tiktok.com/*",
    "https://painel-ao-vivo-jhonatan23.vercel.app/*"
  ],
  "action": {
    "default_title": "V2J · Sincronizar sacolinha",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*"
      ],
      "js": [
        "page-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*"
      ],
      "js": [
        "diag-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*"
      ],
      "js": [
        "diag-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*",
        "https://shop.tiktok.com/view/product/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*"
      ],
      "js": [
        "live-monitor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shop.tiktok.com/streamer/live/*"
      ],
      "js": [
        "live-control.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://painel-ao-vivo-jhonatan23.vercel.app/console.html*"
      ],
      "js": [
        "console-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
